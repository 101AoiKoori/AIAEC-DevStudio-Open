#!/bin/sh
set -eu
py=''
for candidate in .venv/Scripts/python.exe .venv/bin/python python python3; do
    if "$candidate" -c 'import sys, yaml, scipy; sys.exit(sys.version_info < (3, 8))' >/dev/null 2>&1; then
        py=$candidate
        break
    fi
done
if [ -z "$py" ]; then
    echo "需要 Python 3.8+、PyYAML 与 SciPy；请安装后重试（目录契约与状态覆盖使用 YAML/分配器）。" >&2
    exit 2
fi
"$py" lab/scripts/contracts/sync_docs.py --stage
"$py" lab/scripts/contracts/sync_layout_docs.py --stage
"$py" lab/scripts/contracts/workspace_layout.py check --quiet
"$py" lab/scripts/contracts/state_coverage.py --check --staged
"$py" lab/scripts/contracts/full_plan_design.py --check
"$py" lab/scripts/contracts/workspace_ontology.py --check
"$py" lab/scripts/contracts/id_policy.py --check
"$py" lab/scripts/contracts/source_pairing.py --check
"$py" lab/scripts/audit/documentation.py
if [ -f datasets/annotated/car_real_capture_20261112/field_eval_v1/review_v2/review_summary.json ]; then
    "$py" lab/scripts/data/evaluate_field_capture.py audit-labels \
        --labels datasets/annotated/car_real_capture_20261112/field_eval_v1/annotations_root.json \
        datasets/annotated/car_real_capture_20261112/field_eval_v1/annotations_frames.json \
        --review-summary datasets/annotated/car_real_capture_20261112/field_eval_v1/review_v2/review_summary.json \
        >/dev/null
fi
"$py" .agents/skills/workspace-file-governance/scripts/check_layout.py --staged
