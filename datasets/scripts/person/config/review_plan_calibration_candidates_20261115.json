{
  "schema_version": 1,
  "task": "person",
  "batch": "v4_review_calibration_20261115_candidates",
  "purpose": "Bounded cross-parent measurement pool used to choose 24 human-labelled background calibration frames. This is not a training selection and does not replace review_selection.json.",
  "candidate_pool": "datasets/annotated/mixed_scene/v4_compositing_backgrounds_20261113/manifest.json",
  "gate_key": "records",
  "roles": {
    "background": {
      "existing_targets": "allowed_when_labelled",
      "note": "This discovery pool measures ground and placement capacity only; human calibration decides clean, clutter or geometry_failed."
    }
  },
  "sampling": {
    "max_per_parent": 6,
    "min_gap_seconds": 1.0,
    "seed": 1918,
    "max_frames": 36
  },
  "thresholds": {
    "ground_min_area_ratio": 0.02,
    "emptiness_required": false,
    "suspect_min_score": 0.62,
    "near_duplicate_phash_max": 8,
    "near_duplicate_ssim_min": 0.95,
    "require_two_duplicate_signals": true,
    "ground_min_plane_support": 0.3
  },
  "placement": {
    "required": true,
    "target": {
      "height_fraction": 0.3,
      "aspect": 0.42
    },
    "params": {
      "rectified_size": 512,
      "canny_low": 50,
      "canny_high": 150,
      "close_kernel": 7,
      "close_iterations": 2,
      "dilate_kernel": 5,
      "vertical_threshold": 80.0,
      "min_component_area_ratio": 0.01,
      "marking_aspect_min": 5.0,
      "marking_vertical_max": 0.2,
      "floor_grid": 8,
      "floor_sample_fraction": 0.5,
      "floor_mahalanobis_max": 5.0,
      "grid_rows": 9,
      "grid_cols": 15,
      "target_body_free_min": 0.95,
      "edge_density_win": 24,
      "edge_density_max": 0.06,
      "stability_probes": 2
    },
    "thresholds": {
      "max_object_ratio": 0.1,
      "max_object_component_ratio": 0.08,
      "max_vertical_ratio": 0.008,
      "min_largest_free_rect_ratio": 0.5,
      "min_valid_footpoint_ratio": 0.05,
      "max_body_obstacle_ratio": 0.05,
      "clutter_exclude_ratio": 0.15,
      "confidence_min": 0.6,
      "borderline_margin": 0.1
    },
    "verdict": {
      "cluttered": "excluded",
      "uncertain": "unknown"
    },
    "calibration": "discovery_with_current_design_assumptions"
  },
  "emptiness": {
    "params": {
      "suspect_min_score": 0.62,
      "mask_margin_px": 8,
      "nms_iou": 0.3
    },
    "spec": {
      "min_height_fraction": 0.28,
      "back_side": "hard_negative",
      "below_min_scale": "not_a_target"
    }
  },
  "geometry": {
    "ransac_iters": 200,
    "seed": 1918
  },
  "overlays": {
    "enabled": true,
    "verdicts": [
      "ready",
      "unknown",
      "excluded"
    ]
  },
  "outputs": {
    "selection": "datasets/annotated/common/review/person/v4_review_calibration_20261115_candidates/selection.json",
    "metrics_dir": "datasets/annotated/common/review/person/v4_review_calibration_20261115_candidates"
  }
}
